@model IEnumerable<FinancialCsvWeb.Models.FinancialReport>

@{
    ViewData["Title"] = "財報資料列表";
}

<h2>財報資料列表</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="mb-3">
    <a asp-action="Import" class="btn btn-primary">匯入 CSV</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="輸入公司代號或公司名稱" />
    </div>

    <div class="col-md-3">
        <select name="sort" class="form-select">
            <option value="">公司代號排序</option>
            <option value="assets_desc">資產總計：高到低</option>
            <option value="assets_asc">資產總計：低到高</option>
            <option value="debt_desc">負債總計：高到低</option>
            <option value="equity_desc">權益總計：高到低</option>
            <option value="networth_desc">每股參考淨值：高到低</option>
        </select>
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-success">查詢</button>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>年度</th>
            <th>季別</th>
            <th>公司代號</th>
            <th>公司名稱</th>
            <th class="text-end">資產總計</th>
            <th class="text-end">負債總計</th>
            <th class="text-end">權益總計</th>
            <th class="text-end">負債比</th>
            <th class="text-end">每股參考淨值</th>
            <th>操作</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Year</td>
                <td>@item.Quarter</td>
                <td>@item.CompanyCode</td>
                <td>@item.CompanyName</td>
                <td class="text-end">@item.TotalAssets?.ToString("N0")</td>
                <td class="text-end">@item.TotalLiabilities?.ToString("N0")</td>
                <td class="text-end">@item.TotalEquity?.ToString("N0")</td>
                <td class="text-end">@item.DebtRatio?.ToString("N2")%</td>
                <td class="text-end">@item.NetWorthPerShare?.ToString("N2")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">詳細</a>
                </td>
            </tr>
        }
    </tbody>
</table>
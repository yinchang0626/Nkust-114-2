<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - FinancialCsvWeb</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="FinancialReports" asp-action="Index">
                財報 CSV 系統
            </a>

                <div class="navbar-nav">
                    <a class="nav-link" asp-controller="FinancialReports" asp-action="Index">財報列表</a>
                    <a class="nav-link" asp-controller="FinancialReports" asp-action="Analysis">財報分析</a>
                    <a class="nav-link" asp-controller="FinancialReports" asp-action="Import">匯入 CSV</a>
                </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>
</body>
</html>
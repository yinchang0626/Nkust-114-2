@page
@model IndexModel
@{
    ViewData["Title"] = "台灣 A1 類重大交通事故分析系統";
}

<div class="container mt-4" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    <h2 class="mb-4" style="font-weight: 700; color: #1d1d1f;">📊 台灣 A1 類重大交通事故查詢系統</h2>

    <div class="card border-0 shadow-sm p-4 mb-4" style="background-color: #ffffff; border-radius: 12px;">
        <form class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" style="color: #86868b; font-size: 13px;">🔍 發生地點</label>
                <input type="text" id="SearchLocation" class="form-control" placeholder="例如: 中正路" style="border-radius: 8px; height: 40px;">
            </div>

            <div class="col-md-4">
                <label class="form-label" style="color: #86868b; font-size: 13px;">⚡ 主要肇因</label>
                <input type="text" id="SearchCause" class="form-control" placeholder="例如: 恍神、酒醉" style="border-radius: 8px; height: 40px;">
            </div>

            <div class="col-md-3">
                <label class="form-label" style="color: #86868b; font-size: 13px;">🚗 涉案車種</label>
                <input type="text" id="SearchVehicle" class="form-control" placeholder="例如: 機車、小客車" style="border-radius: 8px; height: 40px;">
            </div>

            <div class="col-md-2">
                <button type="button" id="btnFilter" class="btn btn-primary w-100 fw-bold" style="background-color: #0071e3; border: none; border-radius: 8px; height: 40px;">執行篩選</button>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="background-color: #ffffff;">
                <thead style="background-color: #f5f5f7; color: #1d1d1f;">
                    <tr>
                        <th style="padding: 15px; width: 80px;">序號</th>
                        <th style="width: 250px;">發生地點</th>
                        <th style="width: 250px;">主要肇因</th>
                        <th>涉案當事人車種</th>
                    </tr>
                </thead>
                <tbody id="resultTableBody">
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">正在載入 1119 筆 A1 類重大車禍數據...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    let allAccidents = [];

    async function fetchAccidents() {
        try {
            // 直接讀取 wwwroot 底下的 JSON 檔案
            const response = await fetch('/NPA_TMA1_JSON.json');
            const data = await response.json();
            
            // 讀取 JSON 裡面的 records 陣列
            allAccidents = data.result.records || data;
            renderTable(allAccidents);
        } catch (error) {
            document.getElementById('resultTableBody').innerHTML =
                `<tr><td colspan="4" class="text-center text-danger py-4">❌ 載入 JSON 失敗，請確認是否有將 NPA_TMA1_JSON.json 複製到 trafficUI 專案的 wwwroot 資料夾內！</td></tr>`;
        }
    }

    function renderTable(dataList) {
        const tbody = document.getElementById('resultTableBody');
        if (dataList.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-muted">🔍 找不到符合條件的事故紀錄</td></tr>`;
            return;
        }

        tbody.innerHTML = dataList.map((item, index) => {
            // 1. 發生地點：精確對齊
            const location = item["發生地點"] || "未登錄";

            // 2. 🔥 主要肇因：完美對齊第 26 行的「肇因研判子類別名稱-主要」
            const cause = item["肇因研判子類別名稱-主要"] || "其他";

            // 3. 🔥 涉案車種：完美對齊第 29 行的「當事者區分-類別-大類別名稱-車種」
            const vehicle = item["當事者區分-類別-大類別名稱-車種"] || "其他";

            return `
                <tr>
                    <td style="padding: 15px; font-weight: 600; color: #86868b;">${index + 1}</td>
                    <td class="fw-bold text-dark">${location}</td>
                    <td><span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-20 p-2">${cause}</span></td>
                    <td class="text-secondary">${vehicle}</td>
                </tr>
            `;
        }).join('');
    }

    // 核心篩選功能
    document.getElementById('btnFilter').addEventListener('click', () => {
        const locationFilter = document.getElementById('SearchLocation').value.trim().toLowerCase();
        const causeFilter = document.getElementById('SearchCause').value.trim().toLowerCase();
        const vehicleFilter = document.getElementById('SearchVehicle').value.trim().toLowerCase();

        const filteredData = allAccidents.filter(item => {
            const loc = (item["發生地點"] || "").toLowerCase();
            const cause = (item["肇因研判子類別名稱-主要"] || "").toLowerCase();
            const veh = (item["當事者區分-類別-大類別名稱-車種"] || "").toLowerCase();

            return (!locationFilter || loc.includes(locationFilter)) &&
                   (!causeFilter || cause.includes(causeFilter)) &&
                   (!vehicleFilter || veh.includes(vehicleFilter));
        });

        renderTable(filteredData);
    });

    fetchAccidents();
</script>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   })